---
// Both font subsets a Polish page uses, preloaded: fetched with the stylesheet, not after it.
import latinExt from '@fontsource-variable/atkinson-hyperlegible-next/files/atkinson-hyperlegible-next-latin-ext-wght-normal.woff2?url';
import latin from '@fontsource-variable/atkinson-hyperlegible-next/files/atkinson-hyperlegible-next-latin-wght-normal.woff2?url';
import '../fonts.css';
import '../styles.css';
import { SITE_NAME } from '../consts';
import SiteFooter from '../SiteFooter/SiteFooter.astro';
import SiteHeader from '../SiteHeader/SiteHeader.astro';

interface Props {
  /** The page's own title; the site name follows it (the home page is the site name alone). */
  title?: string;
  description: string;
  /** Not found: no canonical, kept out of the index. */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const fullTitle = title ? `${title} | ${SITE_NAME}` : SITE_NAME;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const image = new URL('/og.png', Astro.site).href;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <link rel="preload" href={latin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={latinExt} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE_NAME}, ${Astro.site?.host}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
  </head>
  <body>
    <div class="page">
      <SiteHeader />
      <slot />
      <SiteFooter />
    </div>
  </body>
</html>
